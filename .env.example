# Central service only. Copy to an ignored .env for local development.
# Production Windows services must receive these values from the service manager
# or an explicitly configured, ACL-protected file outside the repository.
CLINIC_REPORTER_ENV=development
CLINIC_REPORTER_STATE_DIR=C:\ProgramData\ClinicAntiviralReporter-DEV
CLINIC_REPORTER_HIS_SOURCE_PATH=\\192.0.2.199\REPLACE_WITH_READ_ONLY_SHARE\DATA
CLINIC_REPORTER_BACKUP_ROOT=\\192.0.2.199\REPLACE_WITH_DEDICATED_BACKUP_SHARE\ClinicAntiviralReporter\CENTRAL_HOST_ID
CLINIC_REPORTER_BIND_HOST=127.0.0.1
CLINIC_REPORTER_BIND_PORT=8000
CLINIC_REPORTER_HIS_SCAN_INTERVAL_SECONDS=60
CLINIC_REPORTER_BACKUP_INTERVAL_SECONDS=1800
# Enable only after the central identity and dedicated destination ACLs are configured.
CLINIC_REPORTER_BACKUP_ENABLED=false
# Synthetic backups use STATE_DIR\synthetic-backups on a dedicated local TEMP root.
CLINIC_REPORTER_SYNTHETIC_BACKUP_ENABLED=false
CLINIC_REPORTER_EXPORT_ENABLED=false
# Fixed synthetic samples only; never enable for a production service.
CLINIC_REPORTER_SYNTHETIC_ENABLED=false
# Optional synthetic DBF worker; reads STATE_DIR\synthetic-dbf, never HIS_SOURCE_PATH.
# Prepare synthetic fixtures explicitly with scripts.synthetic_dbf before enabling.
CLINIC_REPORTER_SYNTHETIC_DBF_ENABLED=false
# Configure go-live and the initial scan date through the administrator UI.
# The worker waits until that explicit configuration exists.
