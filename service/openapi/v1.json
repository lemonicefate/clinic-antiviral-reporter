            "type": "integer",
            "title": "Reportedquantity"
          },
          "material": {
            "type": "string",
            "title": "Material"
          },
          "overdue": {
            "type": "boolean",
            "title": "Overdue"
          },
          "duplicateConcern": {
            "type": "boolean",
            "title": "Duplicateconcern"
          },
          "status": {
