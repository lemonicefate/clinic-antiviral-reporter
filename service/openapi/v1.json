          "revision",
          "chartNumber",
          "patientName",
          "birthDate",
          "physician",
          "reportingDate",
          "sourceOrder",
          "sourceQuantity",
          "reportedQuantity",
          "material",
          "overdue",
          "duplicateConcern",
          "snapshots"
