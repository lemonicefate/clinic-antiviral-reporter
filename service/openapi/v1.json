  "components": {
    "schemas": {
      "AuditView": {
        "properties": {
          "sequence": {
            "type": "integer",
            "title": "Sequence"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "deviceId": {
            "type": "string",
            "title": "Deviceid"
          },
          "operator": {
            "type": "string",
            "title": "Operator"
          },
          "occurredAt": {
            "type": "number",
            "title": "Occurredat"
          },
          "changes": {
            "additionalProperties": true,
            "type": "object",
            "title": "Changes"
          }
        },
        "type": "object",
        "required": [
          "sequence",
          "kind",
          "deviceId",
          "operator",
          "occurredAt",
          "changes"
        ],
        "title": "AuditView"
      },
      "CreatePairing": {
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid",
            "title": "Requestid"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expectedrevision"
          },
          "capabilities": {
            "items": {
              "type": "string",
              "enum": [
                "admin",
                "physician",
                "reporting"
              ]
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Capabilities"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requestId",
          "expectedRevision",
          "capabilities"
        ],
        "title": "CreatePairing"
      },
      "CreateSession": {
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid",
            "title": "Requestid"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expectedrevision"
          },
          "operator": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Operator"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requestId",
          "expectedRevision",
          "operator"
        ],
        "title": "CreateSession"
      },
      "DeviceView": {
        "properties": {
          "deviceId": {
            "type": "string",
            "title": "Deviceid"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "capabilities": {
            "items": {
              "type": "string",
              "enum": [
                "admin",
                "physician",
                "reporting"
              ]
            },
            "type": "array",
            "title": "Capabilities"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "revoked": {
            "type": "boolean",
            "title": "Revoked"
          }
        },
        "type": "object",
        "required": [
          "deviceId",
          "name",
          "capabilities",
          "revision",
          "revoked"
        ],
        "title": "DeviceView"
      },
      "EnrollDevice": {
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid",
            "title": "Requestid"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expectedrevision"
          },
          "pairingCode": {
            "type": "string",
            "maxLength": 43,
            "minLength": 43,
            "title": "Pairingcode"
          },
          "credential": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "title": "Credential"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requestId",
          "expectedRevision",
          "pairingCode",
          "credential",
          "name"
        ],
        "title": "EnrollDevice"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PairingView": {
        "properties": {
          "pairingCode": {
            "type": "string",
            "title": "Pairingcode"
          },
          "expiresAt": {
            "type": "number",
            "title": "Expiresat"
          }
        },
        "type": "object",
        "required": [
          "pairingCode",
          "expiresAt"
        ],
        "title": "PairingView"
      },
      "RevokeDevice": {
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid",
            "title": "Requestid"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expectedrevision"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requestId",
          "expectedRevision",
          "reason"
        ],
        "title": "RevokeDevice"
      },
      "SessionView": {
        "properties": {
          "sessionId": {
            "type": "string",
            "title": "Sessionid"
          },
          "deviceId": {
            "type": "string",
            "title": "Deviceid"
          },
          "operator": {
            "type": "string",
            "title": "Operator"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Capabilities"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "expiresAt": {
            "type": "number",
            "title": "Expiresat"
          }
        },
        "type": "object",
        "required": [
          "sessionId",
          "deviceId",
          "operator",
          "capabilities",
          "revision",
          "expiresAt"
        ],
        "title": "SessionView"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
